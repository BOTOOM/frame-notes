{
  "name": "@frame-notes/extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node copy-onnx-assets.mjs && wxt --browser chrome",
    "build": "node copy-onnx-assets.mjs && wxt build --browser chrome",
    "build:firefox": "node copy-onnx-assets.mjs && wxt build --browser firefox",
    "zip": "node copy-onnx-assets.mjs && wxt zip --browser chrome",
    "zip:firefox": "node copy-onnx-assets.mjs && wxt zip --browser firefox",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@wxt-dev/module-react": "^1.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "wxt": "^0.21.3"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.9",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.2"
  }
}
